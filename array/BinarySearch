public class BinarySearch{
    /*二分查找基础版
    Params：a - 待查找的升序数组
               target - 待查找的目标值
    Return：
            找到则返回索引
            找不到返回-1    */
    public static int binarySearchBasic(int[] a,int target)
    {
        int i = 0,j = a.length;//设置指针和初值
        while(i < j){
            int m = (i + j) >>> 1;
            if(a[m] < target){//目标值在右边
                i = m + 1;
            } else if (target < a[m]){//目标值在左边
                j = m - 1;    
            } else {
                return m;
            }
        }
        return -1;
    }
}